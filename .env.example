# ==========================================
# Telegram API Credentials
# Obtain these from: https://my.telegram.org/apps
# ==========================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Your Telegram phone number in international format (+1XXXXXXXXXX, +91XXXXXXXXXX)
# Used for initial interactive session login
TELEGRAM_PHONE=+919876543210

# Name of the Telethon session file (saved locally as <SESSION_NAME>.session)
SESSION_NAME=extrape_userbot

# ==========================================
# Channel & Bot Routing
# ==========================================
# Comma-separated list of channel usernames (with or without '@') or numeric channel IDs (e.g. -1001234567890)
SOURCE_CHANNELS=lootdeals,techoffers,-1001987654321

# Target ExtraPe Affiliate bot username (for non-Amazon deals: Flipkart, Myntra, Ajio, etc.)
TARGET_BOT=@ExtraPeBot

# ==========================================
# Amazon Direct Affiliate Settings
# ==========================================
# Your personal Amazon Affiliate Associate Tag (e.g., yourtag-21)
AMAZON_AFFILIATE_TAG=your_amazon_tag-21

# Your personal Telegram Channel username (e.g., @mylootdeals) or numeric ID (-100...)
# where converted Amazon deals will be posted directly
MY_TELEGRAM_CHANNEL=@my_channel_username

# Whether to send Amazon deals to ExtraPe (Default is False, to avoid ineligible account errors)
SEND_AMAZON_TO_EXTRAPE=False

# ==========================================
# Forwarding & Filtering Options
# ==========================================
# If TRUE: Sends full original message text + media/photos
# If FALSE: Extracts only matching deal URLs and sends clean links
FORWARD_FULL_MESSAGE=True

# Enable filtering by specific e-commerce domains
FILTER_DOMAINS=True

# Comma-separated keywords/domains to match (checked against URL host/path)
ALLOWED_DOMAINS=amazon,amzn,flipkart,fkrt,myntra,ajio,tatacliq,nykaa,croma,meesho,boat-lifestyle,reliancedigital

# ==========================================
# Anti-Flood & Rate Limiting Settings
# ==========================================
# Random pacing delay (in seconds) between sending messages to prevent Telegram rate limits
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=4.0
